{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StateStorageContract",
  "type": "object",
  "required": [
    "last_check",
    "sites"
  ],
  "properties": {
    "last_check": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO 8601 da última verificação executada com sucesso"
    },
    "sites": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "links"
        ],
        "properties": {
          "links": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "status",
                "alerted"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "ONLINE",
                    "OFFLINE"
                  ],
                  "description": "Estado atual do link"
                },
                "offline_since": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time",
                  "description": "Momento em que o link passou a ficar offline"
                },
                "alerted": {
                  "type": "boolean",
                  "description": "Flag indicando se o alerta de 3 minutos já foi emitido"
                },
                "last_alert_type": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "LINK OFFLINE",
                    "SITE OFFLINE",
                    null
                  ],
                  "description": "Classificação do último alerta emitido"
                },
                "last_alert_timestamp": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time",
                  "description": "Timestamp em que o alerta foi disparado"
                }
              }
            }
          }
        }
      }
    }
  }
}
